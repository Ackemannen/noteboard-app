# Supabase project (Project Settings -> API Keys). Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Google OAuth client (Google Cloud Console -> Credentials).
# Only read by the Supabase CLI (supabase/config.toml) for the local auth stack.
# The hosted project's Google provider is configured in the Supabase dashboard.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
